[Unit]
Description=Inhealth API and production dashboard
After=network.target mariadb.service

[Service]
User=admin
WorkingDirectory=/home/admin/inhealth/webapp
EnvironmentFile=/home/admin/inhealth/webapp/.env
ExecStart=/home/admin/inhealth/venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=temperature_db
DB_USER=admin
DB_PASSWORD=

# Hardware / Serial Configuration
# Windows: COM3
# Linux / VM: /dev/ttyACM0 or /dev/ttyACM1 (or leave blank for auto-detect)
SERIAL_PORT=
SERIAL_BAUD_RATE=9600

# Optional reporting-only AI summary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
